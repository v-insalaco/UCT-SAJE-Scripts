# Front Page HTML Updater for Module Assessment Overview
# Updates the <a> tag on the front page of courses

import requests, glob, json, os, openpyxl
import pandas as pd
from tqdm import tqdm
from datetime import datetime
from bs4 import BeautifulSoup

start = datetime.now()

# Load configuration
with open(os.path.expanduser("~") + r'/config.json') as f:
    configuration = json.load(f)
access_token = configuration["canvas"]["access_token"]
baseUrl = "https://" + configuration["canvas"]["host"] + "/api/v1/courses/"
header = {'Authorization': 'Bearer ' + access_token}
webBaseUrl = f"https://{configuration['canvas']['host']}/courses/"

print(baseUrl)

# Load CSV with course IDs
csv_file = glob.glob('*.csv')
csvfilename = csv_file[0]
df = pd.read_csv(csvfilename, encoding='unicode_escape')
error_log = []


def update_frontpage_html(html, course_id, host):
    """Update the <a> tag with text 'Module Assessment Overview' in the front page HTML."""
    soup = BeautifulSoup(html, 'html.parser')
    changed = False

    a_tag = soup.find('a', string="Module Assessment Overview")
    if a_tag:
        a_tag['style'] = 'padding: 2em 0; height: 100%;'
        a_tag['title'] = 'Module Assessment Overview'
        a_tag['href'] = f"https://{host}/courses/{course_id}/pages/module-assessment-overview-coss"
        a_tag['data-api-endpoint'] = f"https://{host}/api/v1/courses/{course_id}/pages/module-assessment-overview-coss"
        changed = True

    return str(soup), changed


def update_front_page(course_id):
    """Fetch the front page HTML and update the Module Assessment Overview link."""
    front_page_url = baseUrl + f"{course_id}/front_page"
    r = requests.get(front_page_url, headers=header)

    if r.status_code != requests.codes.ok:
        print(f"Failed to fetch front page for course {course_id}: {r.status_code}")
        return False, f"Failed to fetch front page for course {course_id}", None

    page_data = r.json()
    html = page_data.get('body', '')

    updated_html, changed = update_frontpage_html(html, course_id, configuration['canvas']['host'])

    if changed:
        payload = {'wiki_page[body]': updated_html}
        p = requests.put(
            front_page_url,
            headers={**header, 'Content-Type': 'application/x-www-form-urlencoded'},
            data=payload
        )
        if p.status_code == requests.codes.ok:
            print(f"✅ Successfully updated front page for course {course_id}")
            return True, None, page_data.get('html_url')
        else:
            return False, f"Failed to update front page for course {course_id}: {p.status_code}", page_data.get('html_url')

    print(f"Nothing to update for course {course_id}")
    return True, None, page_data.get('html_url')  # No changes needed


def check_homepage_type(course_id):
    """Fetch course details and return default_view."""
    course_url = baseUrl + f"{course_id}"
    r = requests.get(course_url, headers=header)
    if r.status_code != requests.codes.ok:
        print(f"⚠️ Failed to fetch course {course_id} details: {r.status_code}")
        return None

    course_data = r.json()
    return course_data.get('default_view', 'unknown')


def main():
    with tqdm(total=len(df), desc="Updating courses") as pbar:
        for _, row in df.iterrows():
            course_id = row['course_id']
            course_url = f"{webBaseUrl}{course_id}"
            print('\n')

            try:
                default_view = check_homepage_type(course_id)

                if default_view is None:
                    error_log.append({'course_id': course_id, 'URL': course_url, 'Error': "Invalid course ID"})
                    pbar.update(1)
                    continue

                if default_view == 'wiki':
                    print(f"\nCalling update_front_page for course {course_id}")
                    success, msg, front_html_url = update_front_page(course_id)
                    if front_html_url:
                        course_url = front_html_url

                elif default_view == 'syllabus':
                    print(f"\nHomepage is syllabus for course {course_id}, skipping.")
                    success = True
                    msg = None
                else:
                    success = False
                    msg = f"Unknown default_view: {default_view}"

                if not success:
                    error_log.append({'course_id': course_id, 'URL': course_url, 'Error': msg})

            except Exception as e:
                error_log.append({'course_id': course_id, 'URL': course_url, 'Error': str(e)})
                print(f"⚠️ Exception in course {course_id}: {e}")

            pbar.update(1)

    # Save error log
    if error_log:
        df_errors = pd.DataFrame(error_log)
        timestamp = datetime.now().strftime("%d-%m-%Y %H-%M")
        ssname = f"frontpage_html_updater_error_log_{timestamp}.xlsx"
        df_errors.to_excel(ssname, header=True, index=False)

        # Excel formatting
        wb = openpyxl.load_workbook(ssname)
        ws = wb.active

        for column_cells in ws.columns:
            max_length = 0
            column_letter = column_cells[0].column_letter
            for cell in column_cells:
                try:
                    if cell.value:
                        max_length = max(max_length, len(str(cell.value)))
                except:
                    pass
            ws.column_dimensions[column_letter].width = max_length + 5

        wb.save(ssname)
        print("\nError log saved as: %s" % ssname)
    else:
        print("\nNo errors encountered.")


if __name__ == "__main__":
    main()

total_time = datetime.now() - start
print("Running Time:", total_time)
